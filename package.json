{
  "name": "my-dapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal Vite + React + TypeScript QoreChain dApp using @qorechain/sdk to read balances and tokenomics.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "compile": "tsx scripts/compile.ts SealedBidAuction MockPQC",
    "test": "npm run compile --silent && node --import tsx --test test/*.test.ts",
    "demo:local": "tsx scripts/demo-local.ts",
    "testnet": "tsx scripts/testnet.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/qoreseal": "^0.1.0",
    "@qorechain/sdk": "^0.14.0",
    "@scure/bip39": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ganache": "^7.9.2",
    "playwright": "^1.65.1",
    "solc": "^0.8.38",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
